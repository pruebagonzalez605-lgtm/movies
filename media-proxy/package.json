{
  "name": "colevana-tv",
  "version": "1.0.0",
  "private": true,
  "description": "Colevana empaquetado con Capacitor para Android TV",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "sync:version": "node scripts/sync-android-version.mjs",
    "cap:sync": "npm run build:www && npm run sync:version && npx cap sync android",
    "cap:open": "npx cap open android",
    "test": "node --test \"test/*.test.mjs\" \"test/*.test.js\"",
    "deploy": "npm test && npx wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3"
  }
}
